# Nebius Token Factory API Key
# Get your key from: https://studio.nebius.ai/
NEBIUS_API_KEY=your_nebius_api_key_here

# Selected models available on Nebius platform:
# Document Ingestion (Resume / CV parsing into comprehensive JSON):
# Default: Qwen/Qwen3-235B-A22B-Instruct-2507 (235B MoE, 262K context)
INGEST_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# DOM Field Mapping (Matching DOM form fields to user profile):
# Default: Qwen/Qwen3-30B-A3B-Instruct-2507 (30.5B MoE, ultra-low latency, strict JSON)
MAPPING_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

PORT=8000
HOST=0.0.0.0
